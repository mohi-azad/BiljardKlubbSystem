
@model List<MemberCompetition>
<h2>Deltagande</h2>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
        <th>Namn</th>
        <!--<th>Efternamn</th>-->
        <th>Poäng</th>
        <th>Tunering</th>
    </tr>
    @foreach (var mc in Model)
    {
        <tr>
            <td>@mc.FirstName @mc.LastName</td>
            <td>@mc.Score</td>
            <td>@mc.TournamentType</td>
        </tr>
    }
    </thead>
</table>

