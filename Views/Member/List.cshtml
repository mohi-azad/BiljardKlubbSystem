
@model List<Member>
<h2>Alla medlemmar</h2>
<table class="table table-strped table-bordered"> 
    <thead>
        <tr>
            <th>ID</th>
            <th>Namn</th>
            <th>Ålder</th>
            <th>Poäng</th>
        </tr>

        @foreach (var m in Model)
        {
            <tr>
                <td>@m.MemberID</td>
                <td>@m.FirstName @m.LastName</td>
                <td>@m.Age</td>
                <td>@m.Score</td>
            </tr>
        }
    </thead>
</table>
