@model Tournament

<h2> Lägg till turnering</h2>

<form method="post">
    <input type="text" name="TournamentType" placeholder="8-boll, 9-boll, 10-boll, Snooker" replaced />
    <input type="date" name="Date" required />
    <input type="time" name="StartTime" required />
    <button type="Submit"> Skapa tunering</button>
</form>
