@model List<Tournament>

<h2>Tuneringar</h2>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Typ</th>
            <th>Datum</th>
            <th>Starttid</th>
        </tr>

        @foreach (var t in Model)
        {
            <tr>
                <td>@t.TournamentID</td>
                <td>@t.TournamentType</td>
                <td>@t.Date.ToShortDateString()</td>
                <td>@t.StartTime.ToString(@"hh\:mm")</td>
            </tr>
        }
    </thead>
    
</table>
